<?xml version='1.0' encoding='utf-8'?>
<robot name="quadruped8">
  <!-- model-model.xml から q8/urdf.py が生成。手で編集しない（scripts/mjcf_to_urdf.py で作り直す）。 capsule は cylinder + 両端の sphere で近似。アクチュエータ・センサ・接触パラメータ・armature は入らない。 -->
  <mujoco>
    <compiler discardvisual="false" fusestatic="false" strippath="false" />
  </mujoco>
  <material name="vis_accent">
    <color rgba="0.95 0.45 0.10 1" />
  </material>
  <material name="vis_mechanism">
    <color rgba="0.18 0.19 0.21 1" />
  </material>
  <material name="vis_shell">
    <color rgba="0.86 0.86 0.84 1" />
  </material>
