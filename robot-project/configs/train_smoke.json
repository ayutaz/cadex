{
  "_comment": "小規模パイプライン検証用。送る→起動→チェックポイント→回収→検証→再開が一通り通ることと、本番（train_full.json）と同じ大きさの一反復（envs・unroll・epochs・minibatches・hidden）の秒数を測る。方策の良し悪しは見ない。trainer のキーは training/cadex_train.py のフラグ（_ を - に直して -- を付ける）。",
  "name": "smoke",
  "bundle": "robot/mjcf/base/cut/walk-task.json",
  "policy_name": "walk",
  "device": "gpu",
  "env": {
    "CADEX_JAX_CACHE": "/workspace/cache/jax"
  },
  "trainer": {
    "seed": 0,
    "iterations": 10,
    "envs": 8192,
    "unroll": 20,
    "epochs": 4,
    "minibatches": 32,
    "hidden": [
      128,
      64
    ],
    "checkpoint_every": 5,
    "view_seconds": 0,
    "label": "q8 vast.ai smoke",
    "action_filter_alpha": 0.6,
    "no_load_speed": 10.47
  },
  "device_overrides": {
    "cpu": {
      "trainer": {
        "envs": 64,
        "minibatches": 8
      }
    }
  },
  "resume": {
    "critic_warmup": 2,
    "actor_ramp": 0
  },
  "offer": {
    "gpu_name": [
      "RTX 4090",
      "RTX 5090"
    ],
    "num_gpus": 1,
    "min_reliability": 0.97,
    "min_cuda": 12.4,
    "min_disk_gb": 30,
    "min_inet_down_mbps": 1000,
    "max_dph": 0.6,
    "verified": true,
    "limit": 10
  },
  "instance": {
    "image": "ghcr.io/ayutaz/cadex-train:sha-e7f4d9d",
    "disk_gb": 30,
    "label": "q8-smoke"
  },
  "estimate": {
    "seconds_per_iteration": 0.6,
    "setup_minutes": 15,
    "margin": 1.3
  },
  "remote": {
    "work_dir": "/workspace/runs",
    "trainer_root": "/opt/cadex",
    "python": "/opt/venv/bin/python"
  }
}
