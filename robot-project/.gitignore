# uvの仮想環境
.venv/
__pycache__/
*.pyc
.pytest_cache/
# 大きな生成物（再生成できるもの）
artifacts/runs/
# 評価トレース（1評価 約29 MB）は evaluation/evaluate_variant.py で再生成できる
artifacts/**/seed-*-trace.json
artifacts/**/*.webm
artifacts/tmp/
# 認証情報
.env
*.pem
# 製造用STLは scripts/build_robot.py で再生成できる（1機体 約19 MB）。STEPはコミットする
robot/meshes/*/*.stl
